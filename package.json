{
  "name": "dsh-jira-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Show the current Jira account's own issues as a priority-ordered board inside DeepSeek Harness",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg", "README.md"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neilweixing/dsh-jira-board.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
